{
    admin off
    persist_config off
    auto_https off
}

:{$PORT} {
    root * /srv

    # Do NOT gzip large binaries – this often breaks GameMaker loading
    @staticNotBinary not path *.unx *.data *.wasm *.ogg
    encode @staticNotBinary gzip

    # Correct MIME types
    @wasm path *.wasm
    header @wasm Content-Type application/wasm

    @bin path *.data *.unx
    header @bin Content-Type application/octet-stream

    @ogg path *.ogg
    header @ogg Content-Type audio/ogg

    header {
        Accept-Ranges bytes
    }

    file_server
    try_files {path} {path}/ /index.html
}
