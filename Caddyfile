{
    admin off
    persist_config off
    auto_https off
}

:{$PORT} {
    root * /srv
    encode gzip

    # Proper MIME types
    @wasm path *.wasm
    header @wasm Content-Type application/wasm

    @data path *.data *.unx
    header @data Content-Type application/octet-stream

    @ogg path *.ogg
    header @ogg Content-Type audio/ogg

    # Allow large files and range requests (critical for game.unx)
    header {
        Accept-Ranges bytes
    }

    file_server {
        precompressed
    }

    try_files {path} {path}/ /index.html
}
